{
  "name": "Test CLIProxyAPI Connection",
  "nodes": [
    {
      "parameters": {},
      "id": "node-manual",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://cliproxy:8317/v1/models",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer local-proxy-key"
            }
          ]
        }
      },
      "id": "node-test-cliproxy",
      "name": "Test CLIProxyAPI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://cliproxy:8317/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer local-proxy-key"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"model\": \"deepseek-v4-flash\",\n  \"max_tokens\": 50,\n  \"messages\": [\n    {\"role\": \"user\", \"content\": \"Say hello in one sentence\"}\n  ]\n}"
      },
      "id": "node-test-ai",
      "name": "Test AI Call",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "jsCode": "const models = $('Test CLIProxyAPI').first().json;\nconst aiReply = $('Test AI Call').first().json;\n\nreturn [{\n  json: {\n    cliproxy_status: 'OK',\n    model_count: models.data ? models.data.length : 0,\n    ai_reply: aiReply.choices?.[0]?.message?.content || 'No reply',\n    all_good: true\n  }\n}];"
      },
      "id": "node-check-results",
      "name": "Check Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300]
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [[{"node": "Test CLIProxyAPI", "type": "main", "index": 0}]]
    },
    "Test CLIProxyAPI": {
      "main": [[{"node": "Test AI Call", "type": "main", "index": 0}]]
    },
    "Test AI Call": {
      "main": [[{"node": "Check Results", "type": "main", "index": 0}]]
    }
  },
