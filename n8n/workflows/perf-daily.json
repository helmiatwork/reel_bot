{
  "name": "Performance — daily view snapshot",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "days", "daysInterval": 1, "triggerAtHour": 9 }
          ]
        }
      },
      "id": "perf-schedule",
      "name": "Daily 09:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [260, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/performance/refresh",
        "options": { "timeout": 300000 }
      },
      "onError": "continueErrorOutput",
      "id": "perf-refresh",
      "name": "POST /performance/refresh",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/performance/check-targets",
        "options": { "timeout": 300000 }
      },
      "onError": "continueErrorOutput",
      "id": "perf-check",
      "name": "POST /performance/check-targets",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [780, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.OPENCLAW_TELEGRAM_BOT_TOKEN_FOR_REELBOT }}/sendMessage",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "chat_id", "value": "={{ $env.OPENCLAW_TELEGRAM_OWNER_ID_FOR_REELBOT }}" },
            { "name": "text", "value": "=⚠️ n8n: Performance daily snapshot failed — {{ $json.error?.message || 'pipeline-api unreachable' }}" }
          ]
        },
        "options": { "timeout": 15000 }
      },
      "id": "perf-notify-fail",
      "name": "Notify failure (Telegram)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1040, 300]
    }
  ],
  "connections": {
    "Daily 09:00": {
      "main": [
        [
          { "node": "POST /performance/refresh", "type": "main", "index": 0 }
        ]
      ]
    },
    "POST /performance/refresh": {
      "main": [
        [
          { "node": "POST /performance/check-targets", "type": "main", "index": 0 }
        ],
        [
          { "node": "Notify failure (Telegram)", "type": "main", "index": 0 }
        ]
      ]
    },
    "POST /performance/check-targets": {
      "main": [
        [],
        [
          { "node": "Notify failure (Telegram)", "type": "main", "index": 0 }
        ]
      ]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "meta": { "note": "Runs daily 09:00: (1) POST /performance/refresh — fetch current view counts for every posted video, one snapshot per url per day; then (2) POST /performance/check-targets — flag posts below their view target past the horizon, generate an improvement suggestion, and notify (Telegram + dashboard bell). Import + activate in the n8n UI (localhost:5678)." }
}
