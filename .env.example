# ═══════════════════════════════════════════════════════════════
# content-automation/.env.example
# Copy to .env and fill in your values
# NEVER commit .env to git
# ═══════════════════════════════════════════════════════════════

# ── Core ──────────────────────────────────────────────────────
POSTGRES_PASSWORD=change_this_to_strong_password
DOMAIN=general-creation.xyz         # your domain name
DASHBOARD_PASSWORD=change_this       # HTTP Basic Auth password for all web UIs
CLIPROXY_KEY=change_this_to_random_string  # openssl rand -hex 32
TELEGRAM_BOT_TOKEN=                 # get from t.me/BotFather

# ── ArcReel ────────────────────────────────────────────────────
ARCREEL_PASSWORD=your_arcreel_admin_password
ARCREEL_TOKEN=                    # get from ArcReel UI: Settings → API → Generate Token
GEMINI_API_KEY=                   # free at aistudio.google.com/apikey (for ArcReel images)
OPENAI_API_KEY=                   # optional
GROK_API_KEY=                     # optional (for video generation)

# ── Voiceover (Gap 1) ──────────────────────────────────────────
# ElevenLabs: free tier = 10K chars/month
# Get key at: https://elevenlabs.io
ELEVENLABS_API_KEY=               # leave empty to use free gTTS fallback

# ── Platform publishing (Gap 3) ───────────────────────────────

# YouTube — setup: console.cloud.google.com → YouTube Data API v3
# Download client_secrets.json to ./credentials/
YOUTUBE_CREDENTIALS=./credentials/client_secrets.json

# TikTok — requires developer approval (1-2 weeks)
# Register at: developers.tiktok.com
TIKTOK_ACCESS_TOKEN=

# Instagram — requires Meta Developer account + Business IG account
IG_USER_ID=
IG_ACCESS_TOKEN=

# ── Public video storage (required for Instagram API) ─────────
# Option A: Supabase (recommended — free tier sufficient)
STORAGE_TYPE=supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_BUCKET=videos

# Option B: AWS S3 or Cloudflare R2
# STORAGE_TYPE=s3
# S3_ENDPOINT=                    # omit for AWS, set for Cloudflare R2
# S3_KEY=
# S3_SECRET=
# S3_BUCKET=content-videos

# ── Optional: Stock footage + music ───────────────────────────
PEXELS_API_KEY=                   # free at pexels.com/api
FREESOUND_API_KEY=                # free at freesound.org/apiv2

# ── OpenClaw Multi-Bot Telegram Tokens ─────────────────────────
# Each bot requires a unique token from t.me/BotFather
# OPENCLAW_TELEGRAM_OWNER_ID is your Telegram user ID (get via @userinfobot)

# Main Reelbot (general video creation)
OPENCLAW_TELEGRAM_BOT_TOKEN_FOR_REELBOT=   # get from t.me/BotFather
OPENCLAW_TELEGRAM_OWNER_ID_FOR_REELBOT=

# Clipper bot (short-form TikTok/Reels, max 90 seconds)
OPENCLAW_TELEGRAM_BOT_TOKEN_FOR_CLIPPER=   # get from t.me/BotFather
OPENCLAW_TELEGRAM_OWNER_ID_FOR_CLIPPER=

# Director bot (YouTube long-form, 8–20 minutes)
OPENCLAW_TELEGRAM_BOT_TOKEN_FOR_LONGVIDEO= # get from t.me/BotFather
OPENCLAW_TELEGRAM_OWNER_ID_FOR_LONGVIDEO=

# Quill bot (story transformation from URL → custom story)
OPENCLAW_TELEGRAM_BOT_TOKEN_FOR_STORYCOPY= # get from t.me/BotFather
OPENCLAW_TELEGRAM_OWNER_ID_FOR_STORYCOPY=

# ─── N8N ──────────────────────────────────────────────────────
N8N_ENCRYPTION_KEY=                    # openssl rand -hex 16
N8N_USER=admin
N8N_PASSWORD=                          # strong password for n8n UI
HEYGEN_API_KEY=                        # from heygen.com
RAPIDAPI_KEY=                          # from rapidapi.com (Instagram scraper)
