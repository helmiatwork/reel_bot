.env
# YouTube cookies / PO-token secrets — never commit (account credentials)
cookies.txt
**/cookies.txt
secrets/
credentials/client_secrets.json
credentials/youtube_token.json
cliproxy/cli-proxy-api
cliproxy/config.yaml
openclaw/cron/jobs-state.json
__pycache__/
*.pyc
*.log
videos/
output/
nginx/.htpasswd
.dashboard_password
.vscode/
openclaw/agents/main/agent/
openclaw/agents/main/sessions/
openclaw/agents/reelbot/agent/
openclaw/agents/reelbot/sessions/
openclaw/agents/*/sessions/
.gitnexus
.claude/
docker-compose.override.yml

# OAuth token (never commit)
youtube_token.json

# Playwright MCP artifacts (snapshots/screenshots/downloads)
.playwright-mcp/

# Claude analysis frame images (written at runtime; gitkeep preserves the dir)
analyze-frames/*
!analyze-frames/.gitkeep

# One-time migration markers (scratch, do not commit)
*.migrated

# native installer runtime artifacts (generated, never commit)
/data/
**/.venv/
node_modules/
*.log
Procfile

# user-supplied social cookies (secrets — never commit)
data/cookies/

# serena tooling index (local only)
.serena/
